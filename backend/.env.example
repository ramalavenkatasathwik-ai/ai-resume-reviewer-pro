# Application Configuration
APP_NAME=ai-resume-reviewer-api
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_reviewer

# Security & CORS (Comma-separated list or JSON array of allowed origins - no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Configuration (BYOK - Bring Your Own Key architecture: user supplies API key in request header)
# Confirmed stable models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# API Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ANALYZE_PER_MINUTE=10

# Optional Redis Cache / Rate Limiting (Leave empty for in-memory limiter)
# Format: redis://localhost:6379/0
REDIS_URL=

# Private Storage Configuration (local or supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/private
# For Supabase Storage:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes-private
