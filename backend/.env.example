# Application Configuration
APP_NAME=ai-resume-reviewer-api
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_reviewer

# Security & JWT Authentication
# Mandatory in production: generate using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=resume_pro_session

# Security & CORS (Comma-separated list or JSON array of allowed origins - no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server-Side Google Gemini AI Configuration (Administrator Key)
# Store the real secret key securely in your hosting environment (Render, Railway, Docker)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# API Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ANALYZE_PER_MINUTE=10

# Optional Redis Cache / Rate Limiting (Leave empty for in-memory limiter)
# Format: redis://localhost:6379/0
REDIS_URL=

# Private Storage Configuration (local or supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/private
# For Supabase Storage:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes-private

# Email Delivery Configuration (smtp, resend, sendgrid, or none)
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@resume-reviewer.local
EMAIL_FROM_NAME=AI Resume Reviewer Pro
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

