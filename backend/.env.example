# Application Configuration
APP_NAME=ai-resume-reviewer-api
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Security & CORS (Comma-separated list or JSON array of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Configuration (BYOK - Bring Your Own Key architecture: user supplies API key in request, no server-side key stored)
GEMINI_MODEL=gemini-3.8-flash
